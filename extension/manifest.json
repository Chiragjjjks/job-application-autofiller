{
  "manifest_version": 3,
  "name": "Job Application Autofiller",
  "version": "1.0.0",
  "description": "AI-powered job application autofill",

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "action": {
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/scanner.js"]
    }
  ]
}